# MacQ signing and notarization config.
#
#   cp secrets/config.mk.example secrets/config.mk
#   # fill in the values below, then:
#   make doctor
#
# This file is GNU make syntax and is included by the root Makefile, so every
# setting here reaches the build as a make variable. Do not quote values; the
# Makefile quotes them where needed. Never commit secrets/config.mk.

# ---------------------------------------------------------------- signing ---

# The full name of your Developer ID Application certificate, exactly as it
# appears in `make identities` / `security find-identity -v -p codesigning`.
SIGN_IDENTITY = Developer ID Application: Your Name (ABCDE12345)

# Your 10-character Apple Developer Team ID.
TEAM_ID = ABCDE12345

# ----------------------------------------------------------- notarization ---
# Pick ONE of the three blocks below.

# 1. Stored keychain profile (recommended on your own machine). Create it once:
#
#      xcrun notarytool store-credentials "MacQ-notary" \
#        --apple-id you@example.com \
#        --team-id ABCDE12345 \
#        --password xxxx-xxxx-xxxx-xxxx      # app-specific password
#
#    The credentials then live in your keychain, not in this file.
NOTARY_KEYCHAIN_PROFILE = MacQ-notary

# 2. App Store Connect API key (recommended for CI). Download the .p8 once from
#    App Store Connect > Users and Access > Integrations > App Store Connect API
#    and drop it in this directory.
# ASC_API_KEY_FILE = secrets/AuthKey_ABCDE12345.p8
# ASC_API_KEY_ID = ABCDE12345
# ASC_API_ISSUER_ID = 12345678-1234-1234-1234-123456789012

# 3. Apple ID + app-specific password. Works, but the password is passed on the
#    notarytool command line, so it is briefly visible to `ps` on a shared or CI
#    machine. Prefer 1 or 2.
# APPLE_ID = you@example.com
# APPLE_APP_PASSWORD = xxxx-xxxx-xxxx-xxxx

# --------------------------------------------------------------- optional ---

# Entitlements plist applied when signing the app. MacQ needs none: it is
# unsandboxed and talks to the display over IOKit/DDC, which requires no
# entitlement. Set this only if you add a capability that does.
# ENTITLEMENTS = secrets/MacQ.entitlements

# Provisioning profile, copied into MacQ.app/Contents/embedded.provisionprofile
# before signing. Developer ID apps need one only for entitlements that must be
# provisioned (iCloud, push notifications, app groups, DeviceCheck).
# PROVISIONING_PROFILE = secrets/MacQ_DeveloperID.provisionprofile

# Exported Developer ID certificate + private key, for machines where the
# identity is not already in the login keychain (CI). Import it with:
#
#      make keychain-import
#
# CERT_P12 = secrets/DeveloperID_Application.p12
# CERT_P12_PASSWORD = the-password-you-set-when-exporting

# Restrict codesign to a specific keychain. Usually unnecessary: after
# `make keychain-import` the build keychain is in the search list already.
# CODESIGN_KEYCHAIN = macq-build.keychain-db

# Override the version baked into the app and the DMG filename. By default both
# come from MARKETING_VERSION / CURRENT_PROJECT_VERSION in the Xcode project.
# VERSION = 0.1.0
# BUILD_NUMBER = 1

# DMG appearance tool: auto (default), create-dmg or hdiutil.
# DMG_TOOL = auto

# ------------------------------------------------------------- publishing ---

# Cloudflare R2, where `make release` uploads the finished DMG, its .sha256
# sidecar and the Sparkle appcast. `make dmg` does not touch any of this: it
# stops once the DMG is notarized, so you can leave this block on its defaults
# and still cut a release by hand.
#
# The upload speaks R2's S3-compatible API, so these are an R2 API token of
# type "Object Read & Write", not a Cloudflare global API key:
#
#   Cloudflare dashboard > R2 > API > Manage API tokens > Create API token
#
# Creating the token shows the access key ID and the secret exactly once. The
# account ID is on the R2 overview page, and is also the first label of the S3
# endpoint shown there (https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID = change-me
R2_ACCESS_KEY_ID = change-me
R2_SECRET_ACCESS_KEY = change-me

# The bucket to upload into, and an optional key prefix within it. Leave
# R2_FOLDER empty to publish at the root of the bucket. The bucket has to
# exist already; the upload does not create one.
#
# Whatever you choose has to be reachable at the public URL the app polls,
# which is SUFeedURL in app/MacQ/Info.plist. Today that is
# https://artifacts.birju.dev/macq/appcast.xml, so the DMG and the appcast go
# to the "macq" folder of the "artifacts" bucket, and that bucket is served at
# artifacts.birju.dev. Change one and you have to change the other.
R2_BUCKET = artifacts
R2_FOLDER = macq

# Where the DMG and the appcast end up publicly. Derived from SUFeedURL, so it
# normally needs no setting at all. Point it at a scratch bucket to rehearse a
# release without offering it to anyone.
# PUBLIC_BASE_URL = https://artifacts.birju.dev/macq

# Sparkle's EdDSA update-signing key needs no password: unlike the .p12, the key
# material is itself the secret, so there is nothing to unlock and no passphrase
# to set here. `make appcast` looks for the exported key file first and falls
# back to the login keychain account named below.
#
# The account is named rather than left to Sparkle's default because this
# machine's default account already holds a different key. sign_update with no
# account would sign MacQ with that one, and every installed copy would reject
# the result. Both settings have working defaults; override them only to move
# the key somewhere else.
#
# SPARKLE_ACCOUNT = macq
# SPARKLE_KEY_FILE = secrets/sparkle_ed25519_private.key
#
# The public half is checked into app/MacQ/Info.plist as SUPublicEDKey, and
# `make doctor` checks that the key in use is its pair. If the private key is
# lost, no future build can ever update an installed copy, so keep a backup
# somewhere offline:
#
#   ./build/sparkle-tools/bin/generate_keys --account macq -x backup.key
