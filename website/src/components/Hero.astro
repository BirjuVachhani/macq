---
import AppleGlyph from './AppleGlyph.astro';
import { site } from '../site.config';
import { loadRelease } from '../lib/release';

// Build time, not request time: this is a static page. See lib/release.ts.
const release = await loadRelease();
---

<div class="hero">
  <h1 class="headline">{site.headline}</h1>

  <div class="cta">
    <a class="download" href={release.download}>
      <AppleGlyph height={20} />
      <span>Download for macOS</span>
    </a>
    {site.releaseStage && <span class="alpha-pill">{site.releaseStage}</span>}
    <span class="version">v{release.version}</span>
  </div>

  <p class="caption">{site.caption}</p>
</div>
