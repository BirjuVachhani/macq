    d="M314.4 482.059H366.8V175.294H314.4V131.471H209.6V175.294H157.2V482.059H209.6V525.882H314.4V482.059ZM262 657.353H104.8V613.529H52.4V569.706H0V87.6471H52.4V43.8236H104.8V0H419.2V43.8236H471.6V87.6471H524V569.706H419.2V613.529H524V745H314.4V701.176H262V657.353Z"
  ></path>
</svg>
