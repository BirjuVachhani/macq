---
/**
 * The Q glyph from the app icon (app/MacQ/AppIcon.icon/Assets/Q.svg), drawn in
 * `currentColor` so it inherits whatever it sits in.
 */

interface Props {
  /** Rendered height in px. The width follows from the 524:745 viewBox. */
  height?: number;
  class?: string;
}

const { height = 22, class: className } = Astro.props;
const width = (524 / 745) * height;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 524 745"
  xmlns="http://www.w3.org/2000/svg"
  fill="currentColor"
  aria-hidden="true"
>
