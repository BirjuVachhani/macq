---
import { site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <a class="brand" href="/" aria-label={site.name}>
    {/* The app's own icon, copied from app/MacQ/Assets.xcassets/AppLogo. The
        anchor is already labelled, so the image is decorative here. */}
    <img class="brand-mark" src="/app_icon.png" width="32" height="32" alt="" />
    <span class="brand-word">{site.name}</span>
  </a>

  <nav class="site-nav">
    {/* Ghost first, then the outlined link: prominence increases toward the
        edge of the window. */}
    <ThemeToggle />

    {
      site.nav.map((item) => (
        <a
          class:list={['pill', item.style === 'outline' ? 'pill-outline' : 'pill-ghost']}
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
